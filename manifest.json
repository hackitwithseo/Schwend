{
  "manifest_version": 3,
  "name": "Instagram InstaSend Button",
  "version": "1.0",
  "description": "Adds Button To InstaSend Reels",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}